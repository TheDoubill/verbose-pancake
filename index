        // --- 2. DRAWER CONTROLS ---
        function openDrawer(key) {
            const data = drawerData[key];
            if (!data) return;

            document.getElementById('drawer-tag').innerText = data.tag;
            document.getElementById('drawer-title').innerText = data.title;
            document.getElementById('drawer-role').innerText = data.role;
            document.getElementById('drawer-overview').innerText = data.overview;
            document.getElementById('drawer-challenge').innerText = data.challenge;
            document.getElementById('drawer-outcomes').innerText = data.outcomes;

            const list = document.getElementById('drawer-deliverables');
            list.innerHTML = '';
            data.deliverables.forEach(item => {
                const li = document.createElement('li');
                li.innerText = item;
                list.appendChild(li);
            });

            const backdrop = document.getElementById('drawer-backdrop');
            const panel = document.getElementById('drawer-panel');

            backdrop.classList.remove('opacity-0', 'pointer-events-none');
            panel.classList.remove('translate-x-full');
            document.body.style.overflow = 'hidden';
        }

        function closeDrawer() {
            const backdrop = document.getElementById('drawer-backdrop');
            const panel = document.getElementById('drawer-panel');

            backdrop.classList.add('opacity-0', 'pointer-events-none');
            panel.classList.add('translate-x-full');
            document.body.style.overflow = '';
        }

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeDrawer();
        });

        // --- 3. FILTER SYSTEM ---
        const filterButtons = document.querySelectorAll('.filter-btn');
        const projectCards = document.querySelectorAll('.project-card');

        filterButtons.forEach(btn => {
            btn.addEventListener('click', () => {
                filterButtons.forEach(b => b.classList.remove('filter-btn-active'));
                btn.classList.add('filter-btn-active');

                const filter = btn.getAttribute('data-filter');
                projectCards.forEach(card => {
                    if (filter === 'all' || card.getAttribute('data-category') === filter) {
                        card.style.display = 'flex';
                    } else {
                        card.style.display = 'none';
                    }
                });
            });
        });

        // --- 3B. ARCHIVE FILTER SYSTEM ---
        const archiveButtons = document.querySelectorAll('.archive-filter-btn');
        const archiveRows = document.querySelectorAll('.archive-row');

        archiveButtons.forEach(btn => {
            btn.addEventListener('click', () => {
                archiveButtons.forEach(b => {
                    b.classList.remove('archive-filter-active', 'bg-white/10', 'text-offwhite', 'border-amberAccent/50');
                });
                btn.classList.add('archive-filter-active', 'bg-white/10', 'text-offwhite', 'border-amberAccent/50');

                const filter = btn.getAttribute('data-archive-filter');
                archiveRows.forEach(row => {
                    if (filter === 'all' || row.getAttribute('data-category') === filter) {
                        row.style.display = 'flex';
                    } else {
                        row.style.display = 'none';
                    }
                });
            });
        });

        // --- 4. INQUIRY SELECTOR ---
        let selectedInquiry = 'Event Programming';

        function selectInquiry(category, element) {
            selectedInquiry = category;
            document.querySelectorAll('.inquiry-pill').forEach(p => {
                p.classList.remove('bg-amberAccent', 'text-obsidian', 'border-amberAccent');
                p.classList.add('text-zincMuted');
            });
            element.classList.add('bg-amberAccent', 'text-obsidian', 'border-amberAccent');
            element.classList.remove('text-zincMuted');
        }

        function handleInquirySubmit(e) {
            e.preventDefault();
            const name = document.getElementById('sender-name').value;
            const email = document.getElementById('sender-email').value;
            const details = document.getElementById('inquiry-details').value;

            const subject = encodeURIComponent(`[Inquiry - JMDOUVILLE.COM] ${selectedInquiry} — ${name}`);
            const body = encodeURIComponent(`Hello Jean-Marc,\n\nI am reaching out regarding: ${selectedInquiry}\n\nFrom: ${name} (${email})\n\nNotes:\n${details}\n\nBest,\n${name}`);

            window.location.href = `mailto:jm@jmdouville.com?subject=${subject}&body=${body}`;
            showToast('Mail client launched with formatted inquiry!');
        }

        // --- 5. CLIPBOARD & TOAST ---
        function copyEmail() {
            const emailText = document.getElementById('email-address').innerText;
            const tempInput = document.createElement('textarea');
            tempInput.value = emailText;
            document.body.appendChild(tempInput);
            tempInput.select();
            document.execCommand('copy');
            document.body.removeChild(tempInput);

            showToast('Copied email (jm@jmdouville.com) to clipboard');
        }

        function showToast(msg) {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            toast.className = 'bg-surface border border-amberAccent px-4 py-2.5 rounded-full text-offwhite font-mono text-xs shadow-xl pointer-events-auto transition-all duration-300';
            toast.innerText = msg;
            container.appendChild(toast);
            setTimeout(() => {
                toast.classList.add('opacity-0');
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        // --- 6. MOBILE MENU ---
        const mobileBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        const hamIcon = document.getElementById('hamburger-icon');
        const closeIcon = document.getElementById('close-icon');

        mobileBtn.addEventListener('click', () => {
            const open = !mobileMenu.classList.contains('hidden');
            if (open) {
                mobileMenu.classList.add('hidden');
                hamIcon.classList.remove('hidden');
                closeIcon.classList.add('hidden');
            } else {
                mobileMenu.classList.remove('hidden');
                hamIcon.classList.add('hidden');
                closeIcon.classList.remove('hidden');
            }
        });

        document.querySelectorAll('.mobile-nav-link').forEach(link => {
            link.addEventListener('click', () => {
                mobileMenu.classList.add('hidden');
                hamIcon.classList.remove('hidden');
                closeIcon.classList.add('hidden');
            });
        });

        document.getElementById('current-year').innerText = new Date().getFullYear();
    </script>
